APP_ADMIN_PASSWORD=change-this
ADMIN_SESSION_SECRET=change-this-too-a-long-random-string
PUBLIC_BASE_URL=https://YOUR-DOMAIN.com

PUBLIC_MODEL_NAME=dsa-solver
PUBLIC_PROVIDER_NAME=multi-model-dsa

# --- PaddleOCR (runs locally in this process; no API key, no
# external network call at request time) ---
# Model weights are downloaded automatically on first use and cached
# on disk (see the Dockerfile/docker-compose volume) so they aren't
# re-downloaded on every restart.
PADDLE_OCR_LANG=en
# "cpu", "gpu", "gpu:0", etc.
PADDLE_OCR_DEVICE=cpu
# Mobile detection model on purpose: the server variant's peak memory
# gets the process OOM-killed on 2 GB hosts (e.g. Vercel Hobby).
# Setting a model name makes paddleocr ignore PADDLE_OCR_LANG, so the
# recognition model must be set alongside it. Set DET_MODEL=lang to let
# PADDLE_OCR_LANG pick the models instead.
PADDLE_OCR_DET_MODEL=PP-OCRv5_mobile_det
PADDLE_OCR_REC_MODEL=en_PP-OCRv5_mobile_rec
# "max" = longest side never exceeds the limit (bounds activation memory)
PADDLE_OCR_DET_LIMIT_TYPE=max
PADDLE_OCR_DET_LIMIT_SIDE_LEN=2000
PADDLE_OCR_USE_TEXTLINE_ORIENTATION=true
PADDLE_OCR_USE_DOC_ORIENTATION_CLASSIFY=false
PADDLE_OCR_USE_DOC_UNWARPING=false
# How many screenshots can be OCR'd truly concurrently; each unit
# keeps its own copy of the model weights warm in memory. Keep this at
# 1 unless you have plenty of RAM (2 copies + decoded screenshots is
# enough to OOM a 2 GB host, e.g. Vercel Hobby).
OCR_MAX_CONCURRENCY=1
# Load the OCR model pool at startup instead of on the first request.
PRELOAD_OCR_ON_STARTUP=true

# --- Gemini (one of two independent solvers) ---
GEMINI_API_KEY=
GEMINI_MODEL=
# Rarely needed: override to route Gemini traffic through a proxy or a
# recording mock (mirrors GROK_BASE_URL).
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Grok / xAI (the other independent solver) ---
# Get a key at https://console.x.ai. Base URL rarely needs to change.
GROK_API_KEY=
GROK_MODEL=
GROK_BASE_URL=https://api.x.ai/v1

# --- Consensus / verification behaviour ---
# When Gemini's and Grok's independently-produced solutions disagree,
# both models cross-verify each other's answer and try to converge on
# one final answer. If they still disagree after that, this provider
# ("gemini" or "grok") is used as the last-resort tiebreaker.
TIEBREAKER_PROVIDER=gemini
# Set to true to always run the full cross-verification round even when
# both models already agree on the first pass (more API calls, slightly
# higher latency, marginal extra safety net).
ALWAYS_VERIFY=false

# --- Limits ---
# Total screenshots per solve request: inline images plus results
# echoed back via the `ocr_results` field of /v1/chat/completions.
MAX_IMAGES=20
MAX_IMAGE_SIZE_MB=10
# Screenshots per POST /v1/ocr call. Vercel caps request bodies at
# 4.5MB and base64 inflates 4/3, so batches must stay small; OCR many
# screenshots by sending several batches and combining the results.
MAX_OCR_BATCH_IMAGES=4
# Total decoded image bytes per /v1/ocr batch. 3MB becomes ~4MB of
# base64 on the wire, just under Vercel's 4.5MB cap. Raise it on hosts
# with no request-body limit (self-hosted Docker).
MAX_OCR_BATCH_BYTES=3000000
# Assembled prompt (characters) accepted by Gemini/Grok; anything
# larger is rejected locally with a clear 413 instead of an opaque
# provider context-length error.
MAX_PROMPT_CHARS=250000

# Per upstream model call (Gemini or Grok) — 540s (9 min) gives a slow,
# detailed answer plenty of room instead of being cut off mid-response.
# Up to 2 sequential rounds can happen per request (solve, then
# arbitration if the two providers disagree — see consensus_solver.py),
# so the worst case is close to 2x this value. If you deploy on Vercel,
# also raise Project Settings -> Functions -> Function Max Duration
# (default 300s, up to 800s on Pro/Enterprise, up to 1800s with the
# extended-max-duration beta) so the platform itself doesn't cut the
# request off before this timeout would. Self-hosted Docker has no such
# outer ceiling.
REQUEST_TIMEOUT_SECONDS=540

ALLOWED_ORIGINS=

DATA_DIR=data

# Optional. Set this on hosts with no persistent disk (e.g. Vercel) so
# the client-facing API key is stable across every redeploy instead of
# regenerating. Generate a value with:
#   python3 -c "import secrets; print('dsa_sk_' + secrets.token_urlsafe(32))"
# Leave blank to fall back to the file-persisted key in DATA_DIR (fine for
# local dev or Docker with a real mounted volume).
PROVIDER_API_KEY=
