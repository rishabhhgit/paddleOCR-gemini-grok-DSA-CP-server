APP_ADMIN_PASSWORD=change-this
ADMIN_SESSION_SECRET=change-this-too-a-long-random-string
PUBLIC_BASE_URL=https://YOUR-DOMAIN.com

PUBLIC_MODEL_NAME=dsa-solver
PUBLIC_PROVIDER_NAME=multi-model-dsa

# --- PaddleOCR (runs locally in this process; no API key, no
# external network call at request time) ---
# Model weights are downloaded automatically on first use and cached
# on disk (see the Dockerfile/docker-compose volume) so they aren't
# re-downloaded on every restart.
PADDLE_OCR_LANG=en
# "cpu", "gpu", "gpu:0", etc.
PADDLE_OCR_DEVICE=cpu
# Mobile detection model on purpose: the server variant's peak memory
# gets the process OOM-killed on 2 GB hosts (e.g. Vercel Hobby).
# Setting a model name makes paddleocr ignore PADDLE_OCR_LANG, so the
# recognition model must be set alongside it. Set DET_MODEL=lang to let
# PADDLE_OCR_LANG pick the models instead.
PADDLE_OCR_DET_MODEL=PP-OCRv5_mobile_det
PADDLE_OCR_REC_MODEL=en_PP-OCRv5_mobile_rec
# "max" = longest side never exceeds the limit (bounds activation memory)
PADDLE_OCR_DET_LIMIT_TYPE=max
PADDLE_OCR_DET_LIMIT_SIDE_LEN=2000
PADDLE_OCR_USE_TEXTLINE_ORIENTATION=true
PADDLE_OCR_USE_DOC_ORIENTATION_CLASSIFY=false
PADDLE_OCR_USE_DOC_UNWARPING=false
# How many screenshots can be OCR'd truly concurrently; each unit
# keeps its own copy of the model weights warm in memory. Keep this at
# 1 unless you have plenty of RAM (2 copies + decoded screenshots is
# enough to OOM a 2 GB host, e.g. Vercel Hobby).
OCR_MAX_CONCURRENCY=1
# Load the OCR model pool at startup instead of on the first request.
PRELOAD_OCR_ON_STARTUP=true

# --- Gemini (one of two independent solvers) ---
# Google's OpenAI-compatible surface: bearer auth, POST {base}/chat/completions.
GEMINI_API_KEY=
# A model available on that surface, e.g. gemini-2.5-pro.
GEMINI_MODEL=
# Rarely needed: override to route Gemini traffic through a proxy or a
# recording mock (mirrors GROK_BASE_URL). Trailing slash optional.
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Grok (the other independent solver, served by Groq) ---
# Get a key at https://console.groq.com. Same OpenAI-compatible shape.
# A model available on Groq, e.g. openai/gpt-oss-120b — check
# https://console.groq.com/docs/models, slugs get retired/renamed.
GROK_API_KEY=
GROK_MODEL=
GROK_BASE_URL=https://api.groq.com/openai/v1

# --- Consensus / verification behaviour ---
# When Gemini's and Grok's independently-produced solutions disagree,
# both models cross-verify each other's answer and try to converge on
# one final answer. If they still disagree after that, this provider
# ("gemini" or "grok") is used as the last-resort tiebreaker.
TIEBREAKER_PROVIDER=gemini
# Set to true to always run the full cross-verification round, even when
# both models already agree on the first pass. On by default: every
# answer is re-derived and judged by both models instead of being
# trusted because two first passes matched. Costs 2 extra model calls
# per request and adds latency; set false to skip it when they agree.
ALWAYS_VERIFY=true

# --- Limits ---
# EVERY value below: 0 = NO LIMIT. The defaults are all 0, so nothing
# this server owns refuses a request or truncates what it assembles.
#
# Limits that aren't ours still apply and can't be removed here: the
# model's own context window, and — only if you deploy on Vercel — its
# 4.5 MB request-body cap and function duration limit. Self-hosted
# Docker/docker-compose has no such outer ceiling.

# Total screenshots per solve request: inline images plus results
# echoed back via the `ocr_results` field of /v1/chat/completions.
MAX_IMAGES=0
# Per-image decoded size, in MB.
MAX_IMAGE_SIZE_MB=0
# Screenshots per POST /v1/ocr call.
MAX_OCR_BATCH_IMAGES=0
# Total decoded image bytes per /v1/ocr batch.
MAX_OCR_BATCH_BYTES=0
# Assembled prompt (characters) accepted by Gemini/Grok.
MAX_PROMPT_CHARS=0

# Ceiling on how many tokens ONE provider call may generate.
#
#   0 = NO LIMIT (the default): each client asks for the largest budget
#       its provider documents, so generation runs to the model's own
#       output limit. Note that *omitting* the field would NOT be
#       unlimited — Gemini falls back to a model-dependent default far
#       below its real limit, and that default is what used to cut
#       solutions off mid-function (thinking tokens count against it
#       too, so a hard problem could spend the whole budget thinking).
#   >0 = a hard cap you impose.
#
# If a model's own maximum is lower than what we ask for, it replies
# with a 400 naming its ceiling; the client retries there once and
# remembers it for that model. A response the provider still marks as
# truncated is reported as an error rather than returned as a
# complete-looking answer.
SOLVER_MAX_TOKENS=0

# Per upstream model call (Gemini or Grok).
#
#   0 = NO TIMEOUT (the default): the call waits however long the model
#       takes. This server enforces no total request deadline either.
#   >0 = a cap in seconds.
#
# On Vercel the platform still kills the whole request at its function
# duration limit (300s by default, up to 800s on Pro/Enterprise, up to
# 1800s with the extended-max-duration beta) regardless of this value,
# so raise Project Settings -> Functions -> Function Max Duration there
# as well. Self-hosted Docker has no such outer ceiling.
REQUEST_TIMEOUT_SECONDS=0

ALLOWED_ORIGINS=

DATA_DIR=data

# Optional. Set this on hosts with no persistent disk (e.g. Vercel) so
# the client-facing API key is stable across every redeploy instead of
# regenerating. Generate a value with:
#   python3 -c "import secrets; print('dsa_sk_' + secrets.token_urlsafe(32))"
# Leave blank to fall back to the file-persisted key in DATA_DIR (fine for
# local dev or Docker with a real mounted volume).
PROVIDER_API_KEY=
